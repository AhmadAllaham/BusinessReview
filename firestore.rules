rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function enabledUser() {
      return signedIn() &&
        currentProfile().active == true;
    }

    function adminUser() {
      return enabledUser() &&
        currentProfile().role == "admin";
    }

    function gccCountry(country) {
      return country in [
        "GCC",
        "UAE",
        "United Arab Emirates",
        "Qatar",
        "Bahrain",
        "Kuwait",
        "Oman"
      ];
    }

    function allowedCountry(country) {
      return enabledUser() &&
        currentProfile().countries is list &&
        (
          country in currentProfile().countries ||
          ("GCC" in currentProfile().countries && gccCountry(country))
        );
    }

    match /users/{userId} {
      allow read: if enabledUser() &&
        (request.auth.uid == userId || adminUser());
      allow create, update, delete: if adminUser();
    }

    match /system/{documentId} {
      allow read: if enabledUser();
      allow create, update, delete: if adminUser();
    }

    match /datasets/{datasetId} {
      allow read: if enabledUser();
      allow create, update, delete: if adminUser();
    }

    match /reportRows/{rowId} {
      allow read: if adminUser();
      allow create, update, delete: if adminUser();
    }

    match /reportChunks/{chunkId} {
      // The dashboard already requests only the active dataset IDs from
      // system/activeDatasets. Restricting reads here again through a second
      // document lookup caused valid country-scoped list queries to be denied
      // for newly created non-admin users. Keep the security boundary on the
      // signed-in active profile and the chunk country.
      allow read: if adminUser() || allowedCountry(resource.data.country);
      allow create, update, delete: if adminUser();
    }
  }
}
