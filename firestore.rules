rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function enabledUser() {
      return signedIn() &&
        currentProfile().active == true;
    }

    function adminUser() {
      return enabledUser() &&
        currentProfile().role == "admin";
    }

    function activeDatasetId(reportType) {
      return get(/databases/$(database)/documents/system/activeDatasets).data[reportType];
    }

    function allowedCountry(country) {
      return enabledUser() &&
        country in currentProfile().countries;
    }

    match /users/{userId} {
      allow read: if enabledUser() &&
        (request.auth.uid == userId || adminUser());
      allow create, update, delete: if adminUser();
    }

    match /system/{documentId} {
      allow read: if enabledUser();
      allow create, update, delete: if adminUser();
    }

    match /datasets/{datasetId} {
      allow read: if enabledUser();
      allow create, update, delete: if adminUser();
    }

    match /reportRows/{rowId} {
      allow read: if adminUser();
      allow create, update, delete: if adminUser();
    }

    match /reportChunks/{chunkId} {
      allow read: if adminUser() ||
        (
          allowedCountry(resource.data.country) &&
          resource.data.datasetId == activeDatasetId(resource.data.reportType)
        );
      allow create, update, delete: if adminUser();
    }
  }
}
