rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function enabledUser() {
      let active = currentProfile().get("active", true);
      return signedIn() &&
        active != false &&
        active != "false";
    }

    function adminUser() {
      let role = currentProfile().get("role", "user");
      return enabledUser() &&
        role in ["admin", "Admin", "ADMIN"];
    }

    function gccCountry(country) {
      return country in [
        "GCC",
        "UAE",
        "United Arab Emirates",
        "Qatar",
        "Bahrain",
        "Kuwait",
        "Oman"
      ];
    }

    function saudiCountry(country) {
      return country in [
        "KSA",
        "Ksa",
        "ksa",
        "Saudi",
        "SAUDI",
        "saudi",
        "Saudi Arabia",
        "SAUDI ARABIA",
        "saudi arabia",
        "Kingdom of Saudi Arabia"
      ];
    }

    function listHasSaudi(countries) {
      return "KSA" in countries ||
        "Ksa" in countries ||
        "ksa" in countries ||
        "Saudi" in countries ||
        "SAUDI" in countries ||
        "saudi" in countries ||
        "Saudi Arabia" in countries ||
        "SAUDI ARABIA" in countries ||
        "saudi arabia" in countries ||
        "Kingdom of Saudi Arabia" in countries;
    }

    function allowedCountry(country) {
      let countries = currentProfile().get("countries", []);
      return enabledUser() &&
        (
          (
            countries is list &&
            (
              country in countries ||
              (listHasSaudi(countries) && saudiCountry(country)) ||
              ("GCC" in countries && gccCountry(country)) ||
              ("Gcc" in countries && gccCountry(country)) ||
              ("gcc" in countries && gccCountry(country))
            )
          ) ||
          (
            countries is string &&
            (
              country == countries ||
              (saudiCountry(countries) && saudiCountry(country)) ||
              (
                countries in ["GCC", "Gcc", "gcc"] &&
                gccCountry(country)
              )
            )
          )
        );
    }

    match /users/{userId} {
      allow read: if enabledUser() &&
        (request.auth.uid == userId || adminUser());
      allow create, update, delete: if adminUser();
    }

    match /system/{documentId} {
      allow read: if enabledUser();
      allow create, update, delete: if adminUser();
    }

    match /datasets/{datasetId} {
      allow read: if enabledUser();
      allow create, update, delete: if adminUser();
    }

    match /reportRows/{rowId} {
      allow read: if adminUser();
      allow create, update, delete: if adminUser();
    }

    match /reportChunks/{chunkId} {
      allow read: if adminUser() || allowedCountry(resource.data.country);
      allow create, update, delete: if adminUser();
    }
  }
}
